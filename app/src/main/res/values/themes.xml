<resources>
    <style name="Theme.LukashianWidgetConfigure" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBarOverlay">false</item>
        <item name="colorPrimary">?android:attr/windowBackground</item>
        <item name="colorPrimaryDark">?android:attr/windowBackground</item>
        <item name="android:statusBarColor">?android:attr/windowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.LukashianWidgetMain" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBarOverlay">false</item>
        <item name="colorPrimary">@color/darkblue</item>
        <item name="colorPrimaryDark">@color/darkblue</item>
        <item name="android:statusBarColor">@color/darkblue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
