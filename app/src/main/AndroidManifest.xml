<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <package android:name="com.android.art" />
        <package android:name="com.android.libcore" />
    </queries>

    <application
        android:name=".LukashianApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <receiver
            android:name=".widget.LukashianWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.lukashian.calendarwidget.ACTION_WIDGET_GLOBAL_TAP" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lukashian_widget_info" />
        </receiver>

        <activity
            android:name=".widget.LukashianWidgetConfigureActivity"
            android:theme="@style/Theme.LukashianWidgetConfigure"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".main.LukashianMainActivity"
            android:theme="@style/Theme.LukashianMain"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".main.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.lukashian.calendarwidget.ACTION_TRIGGER_ALARM" />
            </intent-filter>
        </receiver>

        <service
            android:name=".main.AlarmService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
        </service>

        <activity
            android:name=".main.LukashianMainAlarmRingActivity"
            android:theme="@style/Theme.LukashianMain"
            android:exported="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance">
        </activity>
    </application>

</manifest>
